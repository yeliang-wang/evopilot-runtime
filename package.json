{
  "name": "@evopilot-next/runtime",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "files": [
    "dist",
    "src",
    "vendor",
    "lifecycle",
    "plugins",
    "README.md",
    "README_CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "provenance"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./workspace-migration": {
      "types": "./dist/workspace-migration.d.ts",
      "import": "./dist/workspace-migration.js"
    },
    "./online": {
      "types": "./dist/online.d.ts",
      "import": "./dist/online.js"
    },
    "./reconstruction-adapters": {
      "types": "./dist/reconstruction-adapters.d.ts",
      "import": "./dist/reconstruction-adapters.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/e2e/*.test.mjs tests/governance.test.mjs",
    "roadmap:gate": "node scripts/roadmap.mjs --gate",
    "roadmap:check": "node scripts/roadmap.mjs --check",
    "roadmap:release": "node scripts/roadmap.mjs --release",
    "test:governance": "node --test tests/governance.test.mjs",
    "lint:correction": "eslint --config eslint.correction.config.mjs src/lifecycle/correction.ts src/lifecycle/correction-contract.ts src/lifecycle/correction-planner.ts src/lifecycle/evidence-qualification.ts --max-warnings 0",
    "test:correction:properties": "node --test tests/e2e/lifecycle-correction-properties-v090.test.mjs",
    "pilot:correction:graph": "node scripts/correction-tooling.mjs graph",
    "pilot:correction:mutation": "node scripts/correction-tooling.mjs mutation",
    "lint:workflows": "node scripts/correction-tooling.mjs actionlint"
  },
  "license": "Apache-2.0",
  "bin": {
    "evopilot-runtime": "dist/server/cli.js",
    "evopilot-runtime-install": "dist/installation/installer.js",
    "evopilot-next-runtime": "dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
