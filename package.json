{
  "name": "@evopilot-next/runtime",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "files": [
    "dist",
    "src",
    "vendor",
    "README.md",
    "README_CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "provenance"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./workspace-migration": {
      "types": "./dist/workspace-migration.d.ts",
      "import": "./dist/workspace-migration.js"
    },
    "./online": {
      "types": "./dist/online.d.ts",
      "import": "./dist/online.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/e2e/*.test.mjs tests/governance.test.mjs",
    "roadmap:gate": "node scripts/roadmap.mjs --gate",
    "roadmap:check": "node scripts/roadmap.mjs --check",
    "roadmap:release": "node scripts/roadmap.mjs --release",
    "test:governance": "node --test tests/governance.test.mjs"
  },
  "license": "Apache-2.0",
  "bin": {
    "evopilot-next-runtime": "dist/cli.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  }
}
